{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vorexway-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-25",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}