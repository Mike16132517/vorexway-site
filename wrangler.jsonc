{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vorexway-site",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "vorexway.ru",
      "custom_domain": true
    },
    {
      "pattern": "www.vorexway.ru",
      "custom_domain": true
    }
  ]
}